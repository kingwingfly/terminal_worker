{
  "name": "os",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo xtask build",
    "build:web": "cargo xtask build --web-only",
    "dev": "node scripts/dev.mjs --ip 127.0.0.1 --port 8787",
    "deploy": "node scripts/deploy.mjs",
    "setup": "node scripts/setup.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "node --test tests/*.test.mjs && cargo test -p os-abi -p os-kernel -p os-userland -p os-core -p os-conformance -p os-client-kernel -p os-vfs -p xtask",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "binaryen": "^132.0.0",
    "esbuild": "^0.25.0",
    "wrangler": "4.152.0"
  }
}
